# Sepid Exchange — Web companion environment
# Copy shared bot vars from .env.sepid.example into the same .env on the server.

# --- Web API ---
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8100
WEB_JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
WEB_JWT_EXPIRE_HOURS=720
WEB_DEV_OTP_IN_RESPONSE=0

# --- Web UI (Next.js) ---
WEB_FRONTEND_PORT=3100
WEB_FRONTEND_URL=http://49.13.132.230:3100
# Optional when UI runs without nginx (dev): absolute API for rewrites
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8100

# --- Required from bot .env (same file on server) ---
# BOT_TOKEN=...
# BOT_USERNAME=Sepid_Group_Bot
# ADVERT_CHANNEL_ID=-100...
# CHANNEL_USERNAME=Sepid_Exchange
# ADMIN_IDS=123456789
# DATABASE_NAME=eurobot.db
# TWILIO_* or TWILIO_VERIFY_SERVICE_SID for production OTP

# --- Admin web actions ---
# BOT_RESTART_COMMAND=systemctl restart telegram-bot
